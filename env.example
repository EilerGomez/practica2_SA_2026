# Copia este archivo como .env y llena los valores reales.

# Keycloak → realm poc-auth → Clients → app-oidc → pestaña Credentials
KEYCLOAK_CLIENT_SECRET=

# Google Cloud Console → APIs y servicios → Credenciales
# Solo necesario si se habilita Google como proveedor adicional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
